+  static const bool on = []() {
+    const char* value = std::getenv("OBSCURA_TRACE_API_ENGINE_CALLS");
+    if (value == nullptr) return false;
+    return strcmp(value, "1") == 0 || strcmp(value, "true") == 0 ||
+           strcmp(value, "on") == 0;
+  }();
+  return on;
+}
+
+bool TraceJsonMode() {
+  static const bool json = []() {
+    const char* format = std::getenv("OBSCURA_TRACE_API_FORMAT");
+    if (format == nullptr) return false;
+    return strcmp(format, "json") == 0 || strcmp(format, "jsonl") == 0 ||
+           strcmp(format, "hahavm") == 0;
+  }();
+  return json;
+}
+
+bool TraceApiCallsEnv() {
+  static const bool on = []() {
+    const char* value = std::getenv("OBSCURA_TRACE_API_CALLS");
+    if (value == nullptr) return false;
