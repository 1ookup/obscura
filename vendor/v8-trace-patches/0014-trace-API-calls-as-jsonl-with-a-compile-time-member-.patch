+// --- API trace: JSON records ------------------------------------------------
+//
+// The JSON mode emits one record per API access or call in the shape the
+// HaHaVM reference trace uses: {t, src, name, args, result}. The probe
+// bytecodes are the same ones the TSV mode uses; only the record shape, the
+// filtering and, for reads, the probe position differ.
+//
+// Two things make this affordable enough to trace a live challenge:
+//
+//   * the name filter is applied before any value is rendered, and for
+//     statically named accesses again at bytecode emission time, so a filtered
+//     access carries no probe at all;
+//   * reads are probed after the load, where the accumulator already holds the
+//     value. That removes the LookupIterator walk the TSV mode needs and is
+//     what makes a real result available without invoking an accessor twice.
+
+struct TraceApiFilter {
+  bool active = false;
+  bool has_includes = false;
+  std::vector<std::string> includes;
+  std::vector<std::string> excludes;
+  // Member part of each include entry, compared against the statically known
+  // member name at bytecode emission time. An entry without a dot is its own
+  // member; an entry with one keeps the text after the last dot, which is a
+  // superset test, since a full "Interface.member" name can only contain the
+  // entry if its member part contains that text.
+  std::vector<std::string> static_hints;
+};
+
+const TraceApiFilter& TraceApiFilters() {
+  static const TraceApiFilter* filter = []() {
+    TraceApiFilter* f = new TraceApiFilter();
+    const char* spec = std::getenv("OBSCURA_TRACE_API_FILTER");
+    if (spec == nullptr || spec[0] == '\0') return f;
+    f->active = true;
+    std::string text(spec);
+    size_t start = 0;
+    for (;;) {
+      size_t comma = text.find(',', start);
+      std::string clause =
+          text.substr(start, comma == std::string::npos ? std::string::npos
+                                                        : comma - start);
+      size_t first = clause.find_first_not_of(" \t");
+      size_t last = clause.find_last_not_of(" \t");
+      clause = first == std::string::npos ? std::string()
+                                          : clause.substr(first, last - first + 1);
+      if (!clause.empty()) {
+        bool exclude = clause[0] == '-';
+        if (exclude || clause[0] == '+') clause.erase(0, 1);
+        if (!clause.empty()) {
+          if (exclude) {
+            f->excludes.push_back(clause);
+          } else {
+            f->includes.push_back(clause);
+            size_t dot = clause.rfind('.');
+            f->static_hints.push_back(dot == std::string::npos
+                                          ? clause
+                                          : clause.substr(dot + 1));
+          }
+        }
+      }
+      if (comma == std::string::npos) break;
+      start = comma + 1;
+    }
+    f->has_includes = !f->includes.empty();
+    return f;
+  }();
+  return *filter;
+}
+
+// A record is kept when it matches no exclusion and, if any include entries
+// exist, at least one of them. Entries are plain substrings of the
+// "Interface.member" name, so "setAttribute" selects it on every interface and
+// "Element.setAttribute" selects the subclasses that end in that text too.
+bool TraceApiNameAccepted(const std::string& name) {
+  const TraceApiFilter& f = TraceApiFilters();
+  if (!f.active) return true;
+  for (const std::string& entry : f.excludes) {
+    if (name.find(entry) != std::string::npos) return false;
+  }
+  if (!f.has_includes) return true;
+  for (const std::string& entry : f.includes) {
+    if (name.find(entry) != std::string::npos) return true;
+  }
+  return false;
+}
