+}
+
+// Samples that share one clock: the JSON stream's t field is milliseconds
+// since the first traced event, so two sides of a comparison only need to
+// agree on their first event rather than on a wall-clock epoch.
+double TraceApiNowMs() {
+  static const base::TimeTicks start = base::TimeTicks::Now();
+  return (base::TimeTicks::Now() - start).InMillisecondsF();
+}
+
+// --- Mid-flight arming ------------------------------------------------------
+//
+// A trace that runs from process start pays for its probes inside the setup
+// phase a comparison depends on, and on a live challenge that is enough to
+// change the page: with the trace on, the run no longer reaches the proof
+// request the untraced run sends. The arm gate keeps every record path at its
+// cheapest until a trigger fires, so the early phase runs at close to
+// untraced speed while the trace still covers the phase of interest.
+//
+// Triggers, read once at first use:
+//   OBSCURA_TRACE_ARM_AT_MS=<ms>   arm once the trace clock passes this value
+//   OBSCURA_TRACE_ARM_FILE=<path>  arm once this path exists (polled, 5 ms)
+// Both may be set; whichever fires first arms the trace. With neither set the
+// trace is armed from the start, which is the behaviour existing callers
+// expect.
+//
+// The gate is checked before any record work: while unarmed there is no name
+// rendering, no constructor-name lookup and no stack walk, so an unarmed probe
+// costs one runtime call plus one relaxed load.
+struct TraceArmConfig {
+  bool time_trigger = false;
+  bool file_trigger = false;
+  double at_ms = 0.0;
+  std::string file;
+};
+
+const TraceArmConfig& TraceArmConfigRef() {
+  static const TraceArmConfig* config = []() {
+    TraceArmConfig* c = new TraceArmConfig();
+    const char* at = std::getenv("OBSCURA_TRACE_ARM_AT_MS");
+    if (at != nullptr && at[0] != '\0') {
+      c->time_trigger = true;
+      c->at_ms = strtod(at, nullptr);
+    }
+    const char* file = std::getenv("OBSCURA_TRACE_ARM_FILE");
+    if (file != nullptr && file[0] != '\0') {
+      c->file_trigger = true;
+      c->file = file;
+    }
+    return c;
+  }();
+  return *config;
+}
+
+// Process-lifetime arming state. Relaxed ordering: the flag only ever moves
+// from unarmed to armed, and a probe that misses the transition still records
+// the ones after it.
+std::atomic<bool>* g_trace_armed = new std::atomic<bool>(false);
+std::atomic<int64_t>* g_trace_arm_poll_ms = new std::atomic<int64_t>(0);
+
+bool TraceArmed() {
+  std::atomic<bool>& armed = *g_trace_armed;
+  if (armed.load(std::memory_order_relaxed)) return true;
+  const TraceArmConfig& config = TraceArmConfigRef();
+  if (!config.time_trigger && !config.file_trigger) {
+    armed.store(true, std::memory_order_relaxed);
+    return true;
+  }
+  if (config.time_trigger && TraceApiNowMs() >= config.at_ms) {
+    armed.store(true, std::memory_order_relaxed);
+    return true;
+  }
+  if (config.file_trigger) {
+    const int64_t now = static_cast<int64_t>(TraceApiNowMs());
+    int64_t last = g_trace_arm_poll_ms->load(std::memory_order_relaxed);
+    // One stat per 5 ms per process: the check is on the probe path, so it may
+    // not be a syscall per access.
+    if (now - last >= 5 &&
+        g_trace_arm_poll_ms->compare_exchange_strong(last, now,
+                                                     std::memory_order_relaxed)) {
+      FILE* trigger = fopen(config.file.c_str(), "rb");
+      if (trigger != nullptr) {
+        fclose(trigger);
+        armed.store(true, std::memory_order_relaxed);
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+std::string TraceApiMs(double ms) {
+  char buffer[32];
+  snprintf(buffer, sizeof(buffer), "%.1f", ms);
+  return std::string(buffer);
+}
+
+// One byte budget for every rendered field, shared by both sides of a
+// comparison. The marker counts against the budget, the unit is UTF-8 bytes,
+// and the cut is backed off to a character boundary, so a field at or under
+// the limit is byte-identical whichever engine wrote it and a longer one is
+// cut in the same place with the same suffix. OBSCURA_TRACE_LIMIT overrides it;
+// the reference side reads the same number from its own trace config.
+constexpr int kTraceDefaultFieldLimit = 4096;
+constexpr char kTraceTruncationMarker[] = "...[truncated]";
+
+int TraceFieldLimit() {
+  static const int limit = []() {
+    const char* value = std::getenv("OBSCURA_TRACE_LIMIT");
+    if (value == nullptr || value[0] == '\0') return kTraceDefaultFieldLimit;
+    const int parsed = atoi(value);
+    return parsed > 0 ? parsed : kTraceDefaultFieldLimit;
+  }();
+  return limit;
+}
+
+std::string TraceTruncate(const std::string& value) {
+  const int limit = TraceFieldLimit();
+  if (static_cast<int>(value.size()) <= limit) return value;
+  const int marker = static_cast<int>(sizeof(kTraceTruncationMarker) - 1);
+  int cut = limit - marker;
+  if (cut < 0) cut = 0;
+  // Back off to a UTF-8 lead byte: a cut inside a multi-byte sequence would
+  // leave a field that is neither the original nor a valid prefix of it.
+  while (cut > 0 && (static_cast<unsigned char>(value[cut]) & 0xC0) == 0x80) {
+    cut--;
+  }
+  std::string text = value.substr(0, cut);
+  text += kTraceTruncationMarker;
+  return text;
+}
+
+void TraceAppendJsonString(const std::string& value, std::string* out) {
+  const std::string text = TraceTruncate(value);
+  *out += '"';
+  for (char ch : text) {
+    switch (ch) {
+      case '"': *out += "\\\""; break;
+      case '\\': *out += "\\\\"; break;
+      case '\n': *out += "\\n"; break;
+      case '\r': *out += "\\r"; break;
+      case '\t': *out += "\\t"; break;
+      default:
+        if (static_cast<unsigned char>(ch) < 0x20) {
+          *out += ' ';
+        } else {
+          *out += ch;
+        }
+    }
+  }
+  *out += '"';
+}
+
+// The JS spelling of a number ("1", "1.5"), which is what the reference writer
+// produces with String(v). Non-finite values have no JSON number form and are
+// quoted, as the reference quotes them.
+void TraceAppendJsonNumber(Isolate* isolate, Tagged<Object> value,
+                           std::string* out) {
+  const double number = IsSmi(value) ? static_cast<double>(Smi::ToInt(value))
+                                     : Cast<HeapNumber>(value)->value();
+  if (std::isfinite(number)) {
+    DirectHandle<String> text =
+        isolate->factory()->NumberToString(direct_handle(value, isolate));
+    std::unique_ptr<char[]> c = text->ToCString();
+    *out += c ? c.get() : "0";
+    return;
+  }
+  if (std::isnan(number)) {
+    *out += "\"NaN\"";
+  } else {
+    *out += number > 0 ? "\"Infinity\"" : "\"-Infinity\"";
+  }
+}
+
+void TraceAppendValuePreview(Isolate* isolate, Tagged<Object> value, int depth,
+                             std::string* out);
+void TraceAppendValueText(Isolate* isolate, Tagged<Object> value, int depth,
+                          std::string* out);
+
+// The body of an object value. It is left opaque on purpose: enumerating the
+// object's own keys means allocating a key array inside the trace probe, and
+// on a live page that has crashed runs outright (a GC triggered from the exit
+// hook). The class tag in front of this marker is what a comparison matches
+// on; the reference's key list is a convenience, not an identifier.
+void TraceAppendObjectBody(Isolate* isolate, DirectHandle<JSObject> object,
+                           int depth, std::string* out) {
+  *out += "{}";
+}
+
+// The name a callable reports, including the "bound " prefix a bound
+// function carries. That prefix is what tells one scheduled callback from
+// another in a trace: the reference renders "ƒ bound z9", where "Function {}"
+// leaves the reader unable to say which callback a setTimeout was handed. A
+// bound function is its own type in V8 rather than a kind of JSFunction, so it
+// has to be recognised before the plain function case.
+std::string TraceCallableName(Isolate* isolate, Tagged<Object> value) {
+  if (IsJSBoundFunction(value)) {
+    Tagged<Object> target = Cast<JSBoundFunction>(value)->bound_target_function();
+    if (IsJSFunction(target) || IsJSBoundFunction(target)) {
+      return "bound " + TraceCallableName(isolate, target);
+    }
+    return "bound anonymous";
+  }
+  if (!IsJSFunction(value)) return "anonymous";
+  std::unique_ptr<char[]> name = Cast<JSFunction>(value)->shared()->DebugNameCStr();
+  return (name && name.get()[0] != '\0') ? name.get() : "anonymous";
+}
+
+// The text body of a value, without any JSON quoting: what an object summary
+// or an array reads as inside the string a record carries it in.
+void TraceAppendValueText(Isolate* isolate, Tagged<Object> value, int depth,
+                          std::string* out) {
+  if (IsJSArray(value)) {
+    DirectHandle<JSReceiver> array =
+        direct_handle(Cast<JSReceiver>(value), isolate);
+    // A JSArray's length is an own data property, so this reads no accessor.
+    Tagged<Object> length = Cast<JSArray>(value)->length();
+    int count = IsSmi(length) ? Smi::ToInt(length) : 0;
+    *out += '[';
+    const int shown = count > 8 ? 8 : count;
+    for (int i = 0; i < shown; i++) {
+      if (i) *out += ", ";
+      DirectHandle<Object> element;
+      if (JSReceiver::GetElement(isolate, array, static_cast<uint32_t>(i))
+              .ToHandle(&element)) {
+        TraceAppendValuePreview(isolate, *element, depth + 1, out);
+      } else {
+        *out += "?";
+      }
+    }
+    if (count > shown) *out += ", …+" + std::to_string(count - shown);
+    *out += ']';
+    return;
+  }
+  TraceAppendValuePreview(isolate, value, depth, out);
+}
+
+// Re-entrancy guard. Building a record can run page-visible code: naming a
+// global member goes through the global proxy's interceptor, and reading a
+// descriptor can reach a proxy trap. That code's own accesses would re-enter
+// the trace, and the recursion is unbounded (it ends in a stack overflow that
+// shows up as a bus error on macOS). One flag per thread, set for the whole
+// time a record is being built, is the same guard the reference uses.
+thread_local bool g_trace_rendering = false;
+
+struct TraceRenderScope {
+  TraceRenderScope() { g_trace_rendering = true; }
+  ~TraceRenderScope() { g_trace_rendering = false; }
+};
+
+// A function with no name of its own is still a named member of the object it
+// is bound on, and the record needs that member's name. Recovering it at call
+// time means enumerating the object the function lives on, which allocates
+// inside the exit hook and ends in a stack overflow when the global proxy's
+// interceptor re-enters the trace; that is why the name is recorded while the
+// member is READ instead. The property probe already has both the name and the
+// value in hand, and a read precedes every call in practice: a bare identifier
+// call is a global read, which the read probe covers.
+//
+// The exit hook then does one lookup. No allocation, no enumeration, and the
+// key is a script id and a start position rather than a tagged pointer, which
+// GC moves.
+using TraceCallableKey = std::tuple<void*, int, int>;
+
+TraceCallableKey TraceCallableKeyOf(Isolate* isolate, Tagged<Object> callable) {
+  Tagged<Object> target = callable;
+  if (IsJSBoundFunction(target)) {
+    target = Cast<JSBoundFunction>(target)->bound_target_function();
+  }
+  if (!IsJSFunction(target)) return TraceCallableKey(isolate, -1, -1);
+  Tagged<SharedFunctionInfo> shared = Cast<JSFunction>(target)->shared();
+  int script_id = -1;
+  Tagged<Object> script_obj = shared->script();
+  if (IsScript(script_obj)) script_id = Cast<Script>(script_obj)->id();
+  return TraceCallableKey(isolate, script_id, shared->StartPosition());
+}
+
+std::map<TraceCallableKey, std::string>* TraceCallableTable() {
+  static std::map<TraceCallableKey, std::string>* table =
+      new std::map<TraceCallableKey, std::string>();
+  return table;
+}
+
+std::mutex* TraceCallableMutex() {
+  static std::mutex* mutex = new std::mutex();
+  return mutex;
+}
+
+void TraceRememberCallableName(Isolate* isolate, Tagged<Object> callable,
+                               const std::string& name) {
+  if (name.empty()) return;
+  if (!IsJSFunction(callable) && !IsJSBoundFunction(callable)) return;
+  const TraceCallableKey key = TraceCallableKeyOf(isolate, callable);
+  if (std::get<1>(key) < 0) return;
+  std::lock_guard<std::mutex> lock(*TraceCallableMutex());
+  std::map<TraceCallableKey, std::string>& table = *TraceCallableTable();
+  if (table.find(key) == table.end()) table[key] = name;
+}
+
+std::string TraceRememberedCallableName(Isolate* isolate,
+                                        Tagged<Object> callable) {
+  if (!IsJSFunction(callable) && !IsJSBoundFunction(callable)) return "";
+  const TraceCallableKey key = TraceCallableKeyOf(isolate, callable);
+  if (std::get<1>(key) < 0) return "";
+  std::lock_guard<std::mutex> lock(*TraceCallableMutex());
+  std::map<TraceCallableKey, std::string>& table = *TraceCallableTable();
+  auto it = table.find(key);
+  return it == table.end() ? std::string() : it->second;
+}
+
+// Engine-internal class tags never reach a record: a comparison is against
+// page-visible names. The global object and the location object are spelled
+// lowercase, which is the spelling the reference uses for both.
+std::string TraceNormalizeInterface(std::string owner) {
+  if (owner.empty()) return owner;
+  if (owner[0] == '_') owner.erase(0, 1);
+  if (owner == "ScopedDocument") owner = "Document";
+  if (owner == "Window") owner = "window";
+  if (owner == "Location") owner = "location";
+  return owner;
+}
+
+// A data property's string value, or empty. Reading the descriptor never runs
+// a getter, so nothing the page can observe changes.
+std::string TraceOwnDataString(Isolate* isolate, DirectHandle<JSObject> object,
+                               const char* name) {
+  DirectHandle<Name> key = isolate->factory()->InternalizeUtf8String(name);
+  PropertyDescriptor desc;
+  Maybe<bool> found =
+      JSObject::GetOwnPropertyDescriptor(isolate, object, key, &desc);
+  if (found.IsNothing() || !found.FromJust()) return "";
+  if (!desc.has_value() || !IsString(*desc.value())) return "";
+  std::unique_ptr<char[]> c = Cast<String>(*desc.value())->ToCString();
+  return c ? c.get() : "";
+}
+
+// "<div>" for an element, from the tag the engine stores on the object as own
+// data. The engine's generic Element class carries no tag in its class name,
+// and "Element {}" tells a reader nothing; this is the same data a renderer
+// would use, read without running any getter.
+std::string TraceOwnTagText(Isolate* isolate, Tagged<Object> value) {
+  if (!IsJSObject(value) || IsJSProxy(value)) return "";
+  DirectHandle<JSObject> object = direct_handle(Cast<JSObject>(value), isolate);
+  std::string tag = TraceOwnDataString(isolate, object, "_lname");
+  if (tag.empty()) tag = TraceOwnDataString(isolate, object, "_tagName");
+  if (tag.empty() || tag.size() > 24) return "";
+  for (char& ch : tag) {
+    if (ch >= 'A' && ch <= 'Z') {
+      ch = static_cast<char>(ch - 'A' + 'a');
+    } else if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))) {
+      return "";
+    }
+  }
+  return "<" + tag + ">";
+}
+
+// The interface an object reports through its prototype's own constructor,
+// used only where V8 gives the object no class name of its own: a style object
+// is an "Object" by map and a CSSStyleDeclaration by prototype, and only the
+// second one tells a reader anything. Read as a descriptor, so no getter runs.
+std::string TracePrototypeClassText(Isolate* isolate, Tagged<Object> value) {
+  if (!IsJSObject(value) || IsJSProxy(value)) return "";
+  DirectHandle<JSObject> object = direct_handle(Cast<JSObject>(value), isolate);
+  PrototypeIterator iterator(isolate, object);
+  if (iterator.IsAtEnd()) return "";
+  DirectHandle<JSReceiver> prototype =
+      PrototypeIterator::GetCurrent<JSReceiver>(iterator);
+  if (!IsJSObject(*prototype)) return "";
+  PropertyDescriptor desc;
+  Maybe<bool> found = JSObject::GetOwnPropertyDescriptor(
+      isolate, prototype, isolate->factory()->constructor_string(), &desc);
+  if (found.IsNothing() || !found.FromJust()) return "";
+  if (!desc.has_value() || !IsJSFunction(*desc.value())) return "";
+  std::unique_ptr<char[]> name =
+      Cast<JSFunction>(*desc.value())->shared()->DebugNameCStr();
+  return (name && name.get()[0] != '\0') ? name.get() : "";
+}
+
+// A DOM element's class tag stands in for the element: "HTMLDivElement" is
+// <div> on the reference side, and a tag is what a reader compares.
+std::string TraceElementTagText(const std::string& class_name) {
+  const char* kHtmlPrefix = "HTML";
+  const char* kElementSuffix = "Element";
+  if (class_name.compare(0, 4, kHtmlPrefix) != 0) return "";
+  if (class_name.size() <= 10) return "";
+  if (class_name.compare(class_name.size() - 7, 7, kElementSuffix) != 0) {
+    return "";
+  }
+  std::string tag = class_name.substr(4, class_name.size() - 11);
+  if (tag.empty()) return "";
+  for (char& ch : tag) {
+    if (ch >= 'A' && ch <= 'Z') ch = static_cast<char>(ch - 'A' + 'a');
+    else if (!((ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9'))) return "";
+  }
+  return "<" + tag + ">";
+}
+
+// The preview string one non-scalar value renders as. The reference carries
+// object summaries and arrays inside a JSON string, so this text is a string
+// value on both sides rather than a nested JSON structure.
+void TraceAppendValuePreview(Isolate* isolate, Tagged<Object> value, int depth,
+                             std::string* out) {
+  if (IsString(value)) {
+    std::unique_ptr<char[]> c = Cast<String>(value)->ToCString();
+    std::string text = c ? c.get() : "";
+    *out += '"';
+    *out += text;  // quoting is applied once, by the field writer
+    *out += '"';
+    return;
+  }
+  if (IsSmi(value)) {
+    *out += std::to_string(Smi::ToInt(value));
+    return;
+  }
+  if (IsHeapNumber(value)) {
+    DirectHandle<String> text =
+        isolate->factory()->NumberToString(direct_handle(value, isolate));
+    std::unique_ptr<char[]> c = text->ToCString();
+    *out += c ? c.get() : "0";
+    return;
+  }
+  if (IsTrue(value, isolate)) {
+    *out += "true";
+    return;
+  }
+  if (IsFalse(value, isolate)) {
+    *out += "false";
+    return;
+  }
+  if (IsUndefined(value, isolate)) {
+    *out += "undefined";
+    return;
+  }
+  if (IsNull(value, isolate)) {
+    *out += "null";
+    return;
+  }
+  if (IsJSFunction(value) || IsJSBoundFunction(value)) {
+    *out += "\xC6\x92 ";
+    *out += TraceCallableName(isolate, value);
+    return;
+  }
+  if (IsSymbol(value, isolate)) {
+    *out += "Symbol()";
+    return;
+  }
+  if (IsJSReceiver(value)) {
+    DirectHandle<JSReceiver> receiver =
+        direct_handle(Cast<JSReceiver>(value), isolate);
+    DirectHandle<String> ctor =
+        JSReceiver::GetConstructorName(isolate, receiver);
+    std::unique_ptr<char[]> c = ctor->ToCString();
+    // The class name as the engine spells it. The interface normalization
+    // applies to record names, not to values: a reader comparing class names
+    // is comparing what the page can see, and rewriting one here would hide a
+    // real difference between the engines.
+    std::string tag = c ? c.get() : "?";
+    const std::string element = TraceElementTagText(tag);
+    if (!element.empty()) {
+      *out += element;
+      return;
+    }
+    const std::string own_tag = TraceOwnTagText(isolate, value);
+    if (!own_tag.empty()) {
+      *out += own_tag;
+      return;
+    }
+    if (tag == "Object") {
+      const std::string prototype_class = TracePrototypeClassText(isolate, value);
+      if (!prototype_class.empty()) tag = prototype_class;
+    }
+    *out += tag;
+    *out += " ";
+    if (depth < 2 && IsJSObject(value) && !IsJSProxy(value) &&
+        !IsJSGlobalProxy(value)) {
+      TraceAppendObjectBody(isolate,
+                            direct_handle(Cast<JSObject>(value), isolate), depth,
+                            out);
+    } else {
+      // Past the depth budget the reference collapses to a bare summary, so
+      // the shape matches at any nesting level.
+      *out += "{}";
+    }
+    return;
+  }
+  *out += "<value>";
+}
+
+// The record's rendering of one value: the spellings above, as JSON. A scalar
+// is a JSON native or a short string; anything with a body is one JSON string
+// holding its preview, which is how the reference carries the same value. The
+// whole preview goes through the same byte budget and the same escaping.
+void TraceAppendJsonValue(Isolate* isolate, Tagged<Object> value,
+                          std::string* out) {
+  if (IsString(value)) {
+    std::unique_ptr<char[]> c = Cast<String>(value)->ToCString();
+    TraceAppendJsonString(c ? c.get() : "", out);
+    return;
+  }
+  if (IsSmi(value) || IsHeapNumber(value)) {
+    TraceAppendJsonNumber(isolate, value, out);
+    return;
+  }
+  if (IsTrue(value, isolate)) {
+    *out += "true";
+    return;
+  }
+  if (IsFalse(value, isolate)) {
+    *out += "false";
+    return;
+  }
+  if (IsUndefined(value, isolate)) {
+    *out += "\"undefined\"";
+    return;
+  }
+  if (IsNull(value, isolate)) {
+    *out += "null";
+    return;
+  }
+  std::string preview;
+  TraceAppendValueText(isolate, value, 0, &preview);
+  TraceAppendJsonString(preview, out);
+}
+
+// What a member resolves to on the receiver's chain: the interface that owns
+// it, whether it is an accessor, and where that accessor was defined.
+struct TraceMemberInfo {
+  std::string holder;
+  std::string definition;
+  bool found = false;
+  bool accessor = false;
+};
+
+// One walk answers all three questions, and it runs only for a record that
+// already passed the name filter. Interceptors are skipped and no accessor is
+// invoked, so nothing the page can observe changes.
+//
+// The interface is the holder's own class name. A page calls appendChild on an
+// HTMLBodyElement, but the member belongs to Node, and that is the name the
+// reference records and the one the spec defines it on: V8 reports a
+// prototype object under the class it is the prototype of. The global object
+// is the exception, because its class is what makes a record read "window."
+// and the holder's class is not that.
+TraceMemberInfo TraceLookupMember(Isolate* isolate, DirectHandle<JSAny> receiver,
+                                  DirectHandle<Name> name, bool is_set,
+                                  bool want_definition = true) {
+  TraceMemberInfo info;
+  if (name.is_null() || IsNullOrUndefined(*receiver) ||
+      !IsJSReceiver(*receiver)) {
+    return info;
+  }
+  DirectHandle<JSReceiver> object =
+      direct_handle(Cast<JSReceiver>(*receiver), isolate);
+  const bool is_global = IsJSGlobalProxy(*object);
+  if (is_global) {
+    // Every global read arrives with the global proxy as its receiver, and the
+    // proxy's own lookup is an interceptor that the walk below skips. The
+    // members live on the global object behind it.
+    PrototypeIterator iterator(isolate, object);
+    if (iterator.IsAtEnd()) return info;
+    object = PrototypeIterator::GetCurrent<JSReceiver>(iterator);
+  }
+  LookupIterator it(isolate, object, name,
+                    LookupIterator::PROTOTYPE_CHAIN_SKIP_INTERCEPTOR);
+  if (!it.IsFound()) return info;
+  info.found = true;
+  if (!is_global) {
+    DirectHandle<JSReceiver> holder = it.GetHolder<JSReceiver>();
+    if (!holder.is_null()) {
+      DirectHandle<String> ctor =
+          JSReceiver::GetConstructorName(isolate, holder);
+      std::unique_ptr<char[]> c = ctor->ToCString();
+      info.holder = c ? c.get() : "";
+    }
+  }
+  if (it.state() != LookupIterator::ACCESSOR) return info;
+  info.accessor = true;
+  if (!want_definition) return info;
+  DirectHandle<Object> accessors = it.GetAccessors();
+  if (!IsAccessorPair(*accessors)) return info;
+  Tagged<Object> accessor = Cast<AccessorPair>(*accessors)
+                                ->get(is_set ? ACCESSOR_SETTER : ACCESSOR_GETTER);
+  if (!IsJSFunction(accessor)) return info;
+  DirectHandle<JSFunction> function =
+      direct_handle(Cast<JSFunction>(accessor), isolate);
+  info.definition =
+      TraceFunctionDefinition(isolate, direct_handle(function->shared(), isolate));
+  return info;
+}
+
+// "Interface.member", the name shape both traces use.
+std::string TraceApiRecordName(Isolate* isolate, DirectHandle<JSAny> receiver,
+                               const std::string& member,
+                               DirectHandle<Name> member_name) {
+  if (member.empty()) return "";
+  std::string owner;
+  if (!IsNullOrUndefined(*receiver) && IsJSFunction(*receiver)) {
+    // A static read off a constructor function is named by that constructor's
+    // own name ("URL" for URL.createObjectURL), not by "Function".
+    DirectHandle<SharedFunctionInfo> shared(
+        Cast<JSFunction>(*receiver)->shared(), isolate);
+    std::unique_ptr<char[]> name = shared->DebugNameCStr();
+    if (name && name.get()[0] != '\0') owner = name.get();
+  }
+  if (owner.empty()) {
+    // The name is needed before the filter runs, so this walk asks only for the
+    // holder: resolving an accessor's definition here would pay for every
+    // access the filter is about to drop.
+    owner =
+        TraceLookupMember(isolate, receiver, member_name, false, false).holder;
+  }
+  if (owner.empty()) {
+    // The global object has no constructor to read, and its members are the
+    // window's: that is the interface the reference names them under.
+    if (IsJSGlobalProxy(*receiver) || IsJSGlobalObject(*receiver)) {
+      owner = "window";
+    }
+  }
+  if (owner.empty() && !IsNullOrUndefined(*receiver) && IsJSReceiver(*receiver)) {
+    DirectHandle<String> ctor = JSReceiver::GetConstructorName(
+        isolate, direct_handle(Cast<JSReceiver>(*receiver), isolate));
+    std::unique_ptr<char[]> c = ctor->ToCString();
+    owner = c ? c.get() : "";
+  }
+  if (owner.empty()) {
+    // A member the window holds is the window's, whatever receiver the call
+    // arrived on: the host surface is bound on the global, and a receiver that
+    // reports no class of its own would otherwise leave the record nameless.
+    // Only the receiver's own identity is consulted here - walking the global
+    // object to confirm ownership is what the anonymous-callee path already
+    // does, and doing it again on every named call is not worth its cost.
+    if (IsJSGlobalProxy(*receiver) || IsJSGlobalObject(*receiver)) {
+      owner = "window";
+    }
+  }
+  if (owner.empty()) {
+    if (IsString(*receiver)) {
+      owner = "String";
+    } else if (IsNumber(*receiver)) {
+      owner = "Number";
+    } else if (IsBoolean(*receiver)) {
+      owner = "Boolean";
+    } else if (IsSymbol(*receiver, isolate)) {
+      owner = "Symbol";
+    } else if (IsBigInt(*receiver)) {
+      owner = "BigInt";
+    }
+  }
+  owner = TraceNormalizeInterface(owner);
+  if (owner.empty()) return member;
+  return owner + "." + member;
+}
+
+// The property key behind a member name, for the holder walk on a path that
+// only has the name as text (a call, whose name comes from the callee).
+DirectHandle<Name> TraceMemberName(Isolate* isolate, const std::string& member) {
+  if (member.find('<') != std::string::npos) return DirectHandle<Name>();
+  return isolate->factory()->InternalizeUtf8String(member.c_str());
+}
+
+// The key of a probe, as a Name for the holder walk: a symbol key is already
+// one, and an index key has a name derived from it.
+DirectHandle<Name> TraceKeyName(Isolate* isolate, DirectHandle<Object> key) {
+  if (IsName(*key)) return direct_handle(Cast<Name>(*key), isolate);
+  PropertyKey property_key(isolate, key);
+  return property_key.GetName(isolate);
+}
+
+// Page code the page itself evaluated carries no script name. Both sides call
+// that frame "<page-eval>", which is a realm tag of its own rather than an
+// engine script.
+constexpr char kTracePageEvalTag[] = "<page-eval>";
+
+// The CLI wraps an --eval expression in a fixed one-line prefix, so a position
+// inside that script sits one line below the expression the caller wrote. The
+// CLI sets this when it takes that path; every other entry point leaves it 0.
+int TraceEvalLineBias() {
+  static const int bias = []() {
+    const char* value = std::getenv("OBSCURA_TRACE_EVAL_LINE_BIAS");
+    if (value == nullptr || value[0] == '\0') return 0;
+    return atoi(value);
+  }();
+  return bias;
+}
+
+// Position info both sides read the same way: a line in the script's own
+// source. kNoOffset matters for eval'd code, where the default would report a
+// line in the host script the code was evaluated from instead of the line the
+// page wrote.
+void TraceScriptPosition(Isolate* isolate, DirectHandle<Script> script,
+                         int position, int* line, int* column) {
+  Script::PositionInfo info;
+  *line = 1;
+  *column = 1;
+  if (Script::GetPositionInfo(script, position, &info,
+                              Script::OffsetFlag::kNoOffset)) {
+    *line = info.line + 1;
+    *column = info.column + 1;
+  }
+}
+
+// Where a function was defined: script URL plus start position. This is the
+// left half of the record's src, the "definitions" side.
+std::string TraceFunctionDefinition(Isolate* isolate,
+                                    DirectHandle<SharedFunctionInfo> shared) {
+  Tagged<Object> script_obj = shared->script();
+  if (!IsScript(script_obj)) return "<native>";
+  DirectHandle<Script> script(Cast<Script>(script_obj), isolate);
+  std::string name = "<anonymous>";
+  if (IsString(script->name())) {
+    std::unique_ptr<char[]> c = Cast<String>(script->name())->ToCString();
+    if (c && c.get()[0] != '\0') name = c.get();
+    // A function the worker defined is not engine code, and the definition side
+    // carries the same realm tag as the call site side.
+    if (TraceIsWorkerAuthorScript(name.c_str())) name = TraceWorkerTag(isolate);
+  }
+  SharedFunctionInfo::EnsureSourcePositionsAvailable(isolate, shared);
+  int line = 1;
+  int column = 1;
+  TraceScriptPosition(isolate, script, shared->StartPosition(), &line, &column);
+  if (name == "<eval>") {
+    name = kTracePageEvalTag;
+    line = std::max(1, line - TraceEvalLineBias());
+  }
+  return name + ":" + std::to_string(line) + ":" + std::to_string(column);
+}
+
+// The right half of src: the page frame performing the access, or an empty
+// string when that frame is engine code.
+//
+// Engine-internal accesses are dropped rather than recorded. Bootstrap reads
+// its own API members constantly while it builds the document, and those
+// records describe the engine's implementation, not what the page observed;
+// the reference trace has no counterpart for them. The same rule already
+// selects the TSV stream's records.
+std::string TraceCallSite(Isolate* isolate) {
+  JavaScriptStackFrameIterator frames(isolate);
+  if (frames.done()) return "";
+  std::string where;
+  int line = 0;
+  int column = 0;
+  if (!TraceDescribeFrame(isolate, frames.frame(), &where, &line, &column,
+                          nullptr)) {
+    return "";
+  }
+  return where + ":" + std::to_string(line) + ":" + std::to_string(column);
+}
+
+// The src field: "<operation> <name> (<definition>) <- <call site>".
+//
+// Both halves are always present. "<native>" on the left is an implementation
+// with no JS source position to point at; "<engine>" on the right is an access
+// the engine made rather than the page. A missing half is spelled, never
+// dropped and never "?", so no record is ambiguous about which half is absent.
+std::string TraceApiSrc(const char* operation, const std::string& name,
+                        const std::string& definition,
+                        const std::string& call_site) {
+  std::string src = std::string(operation) + " " + name + " (";
+  src += definition.empty() ? "<native>" : definition;
+  src += ") <- ";
+  src += call_site.empty() ? "<engine>" : call_site;
+  return src;
+}
+
+
+// Renders a property key as display text for a record name.
+std::string TracePropertyMemberText(Isolate* isolate, DirectHandle<Object> key) {
+  if (IsString(*key)) {
+    std::unique_ptr<char[]> c = Cast<String>(*key)->ToCString();
+    return c ? c.get() : "";
+  }
+  if (IsNumber(*key)) {
+    PropertyKey property_key(isolate, key);
+    if (IsString(*property_key.GetName(isolate))) {
+      std::unique_ptr<char[]> c =
+          Cast<String>(*property_key.GetName(isolate))->ToCString();
+      return c ? c.get() : "";
+    }
+    return "<key>";
+  }
+  if (IsSymbol(*key, isolate)) return "<symbol>";
+  return "<key>";
+}
+
+// t is milliseconds since this stream's first record, one decimal, so both
+// sides of a comparison start at 0.0 and only their deltas are compared. The
+// arm gate reads a different clock on purpose: it has to be sampled before the
+// first record exists. A comparison across sides aligns the two streams by
+// their first page-origin record; absolute timestamps are not comparable.
+double TraceApiRecordMs() {
+  static const double* origin = new double(TraceApiNowMs());
+  return TraceApiNowMs() - *origin;
+}
+
+void TraceEnqueueJsonRecord(const std::string& src, const std::string& name,
+                            const std::string& args, const std::string& result) {
+  std::string record = "{\"t\":";
+  record += TraceApiMs(TraceApiRecordMs());
+  record += ",\"src\":";
+  TraceAppendJsonString(src, &record);
+  record += ",\"name\":";
+  TraceAppendJsonString(name, &record);
+  record += ",\"args\":[";
+  record += args;
+  record += "],\"result\":";
+  record += result;
+  record += "}\n";
+  TraceEnqueueLine(record);
+}
+
+// Whether a definition site is page code. A member the page defines itself -
+// a helper function, an object it built - is not a browser API access, and the
+// reference trace has no counterpart for one: it only ever sees members its
+// own environment implements. Recording them would put every page-local call
+// in the way of a comparison that is about API use, so they are dropped rather
+// than left for the reader to filter out.
+bool TraceIsPageDefinition(const std::string& definition) {
+  if (definition.empty()) return false;
+  const size_t column = definition.rfind(':');
+  if (column == std::string::npos) return false;
+  const size_t line = definition.rfind(':', column - 1);
+  if (line == std::string::npos) return false;
+  const std::string script = definition.substr(0, line);
+  return script == kTracePageEvalTag || script == "<eval>" ||
+         script == "<eval-remote>" || script == "<eval-remote-frame>" ||
+         script == "<eval-frame-value>" || script == "<cdp-eval-frame>" ||
+         script == "<anonymous>";
+}
+
+// The definition side of a property record. A callable value is the useful
+// case: it says where the method the page just read or wrote was defined.
+std::string TraceValueDefinition(Isolate* isolate, Tagged<Object> value) {
+  if (IsJSFunction(value)) {
+    DirectHandle<JSFunction> function =
+        direct_handle(Cast<JSFunction>(value), isolate);
+    DirectHandle<SharedFunctionInfo> shared(function->shared(), isolate);
+    return TraceFunctionDefinition(isolate, shared);
+  }
+  return "";
+}
+
+// A write. The value being assigned travels in args, as the reference has it,
+// and the result is "undefined": a setter returns undefined to the caller that
+// invoked it, which is the result a record reports.
+void TraceJsonPropertySet(Isolate* isolate, DirectHandle<JSAny> receiver,
+                          DirectHandle<Object> key, Tagged<Object> value) {
+  if (g_trace_rendering) return;
+  TraceRenderScope render_scope;
+  // Held across the member walk and the value rendering, both of which
+  // allocate: a raw tagged value is only valid until the next allocation.
+  DirectHandle<Object> assigned(value, isolate);
+  const std::string member = TracePropertyMemberText(isolate, key);
+  if (member.empty()) return;
+  const std::string name =
+      TraceApiRecordName(isolate, receiver, member, TraceKeyName(isolate, key));
+  if (name.empty() || !TraceApiNameAccepted(name)) return;
+
+  const std::string call_site = TraceCallSite(isolate);
+  if (call_site.empty() && !TraceApiEngineCallRecords()) return;
+  const TraceMemberInfo member_info =
+      TraceLookupMember(isolate, receiver, TraceKeyName(isolate, key), true);
+  // The reference records a write only when its environment defined a setter
+  // for the member: a store into an ordinary data property dispatches nothing
+  // there. Requiring the same here drops the writes a page makes to its own
+  // objects, which have no counterpart on the other side.
+  if (!member_info.accessor) return;
+  if (TraceIsPageDefinition(member_info.definition)) return;
+  std::string args;
+  TraceAppendJsonValue(isolate, *assigned, &args);
+  std::string src = TraceApiSrc("set", name, member_info.definition, call_site);
+  TraceEnqueueJsonRecord(src, name, args, "\"undefined\"");
+}
+
+// A read: the value has already been loaded, so no accessor runs twice.
+void TraceJsonPropertyGet(Isolate* isolate, DirectHandle<JSAny> receiver,
+                          DirectHandle<Object> key, Tagged<Object> value) {
+  if (g_trace_rendering) return;
+  TraceRenderScope render_scope;
+  // Held across the member walk and the value rendering, both of which
+  // allocate: a raw tagged value is only valid until the next allocation.
+  DirectHandle<Object> read(value, isolate);
+  const std::string member = TracePropertyMemberText(isolate, key);
+  if (member.empty()) return;
+  const std::string name =
+      TraceApiRecordName(isolate, receiver, member, TraceKeyName(isolate, key));
+  if (name.empty() || !TraceApiNameAccepted(name)) return;
+
+  // Record what this member is called, so a later call into it can be named
+  // without enumerating anything (see TraceRememberCallableName).
+  if (IsJSFunction(*read) || IsJSBoundFunction(*read)) {
+    TraceRememberCallableName(isolate, *read, name);
+  }
+  const std::string call_site = TraceCallSite(isolate);
+  if (call_site.empty() && !TraceApiEngineCallRecords()) return;
+  const TraceMemberInfo member_info =
+      TraceLookupMember(isolate, receiver, TraceKeyName(isolate, key), false);
+  // A read whose value is a function is a method reference. The reference
+  // records nothing for one: its members are plain data properties, so reading
+  // one dispatches nothing, and the call record that follows carries the same
+  // information. Only an accessor read is a record on both sides, so a page
+  // that touches a method produces one record there rather than two here.
+  if (IsJSFunction(*read) && !member_info.accessor) return;
+  std::string definition = member_info.definition;
+  if (definition.empty()) definition = TraceValueDefinition(isolate, *read);
+  if (TraceIsPageDefinition(definition)) return;
+  std::string result;
+  TraceAppendJsonValue(isolate, *read, &result);
+  std::string src = TraceApiSrc("get", name, definition, call_site);
+  TraceEnqueueJsonRecord(src, name, std::string(), result);
+}
+
+// One call, emitted at exit so that a single record carries the arguments and
+// the return value. The caller's frame still holds the call site.
+//
+// A class constructor can only be entered through `new`, which is how a
+// construct is told from a call: one exit hook serves both, and the object a
+// construct produced is the frame's receiver rather than its return value. The
+// reference records the same event with the same "new" operation, so a
+// constructor is one record on both sides rather than a call with an undefined
+// result on one of them.
+void TraceCallRecordJson(Isolate* isolate, Tagged<Object> value) {
+  JavaScriptStackFrameIterator frames(isolate);
