From 9fce662c15110d279716a48980542ef7b7884d23 Mon Sep 17 00:00:00 2001
From: l8h6 <l8h6@l8h6deMac-Studio-2.local>
Date: Sat, 5 Sep 2026 20:37:04 +0800
Subject: [PATCH 10/16] trace generated megamorphic named loads

---
 src/ic/accessor-assembler.cc | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/ic/accessor-assembler.cc b/src/ic/accessor-assembler.cc
index 7ee335fb..91133271 100644
--- a/src/ic/accessor-assembler.cc
+++ b/src/ic/accessor-assembler.cc
@@ -4356,6 +4356,11 @@ void AccessorAssembler::GenerateLoadIC_Megamorphic() {
   CSA_DCHECK(this, TaggedEqual(LoadFeedbackVectorSlot(CAST(vector), slot),
                                MegamorphicSymbolConstant()));
 
+  // The megamorphic generated path bypasses IC::Load and the runtime miss
+  // handlers for ordinary objects. Route it through the same native monitor
+  // before probing the stub cache; the helper is a no-op when tracing is off.
+  CallRuntime(Runtime::kTracePropertyLookup, context, receiver, name);
+
   TryProbeStubCache(isolate()->load_stub_cache(), receiver, CAST(name),
                     &if_handler, &var_handler, &miss);
 
