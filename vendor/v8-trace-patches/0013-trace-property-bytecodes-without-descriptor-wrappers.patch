+std::string TraceEscapeField(const std::string& value) {
+  std::string escaped;
+  for (char ch : value) {
+    switch (ch) {
+      case '\\': escaped += "\\\\"; break;
+      case '\t': escaped += "\\t"; break;
+      case '\r': escaped += "\\r"; break;
+      case '\n': escaped += "\\n"; break;
+      default: escaped += ch; break;
+    }
+  }
+  return escaped;
+}
