+void BytecodeArrayBuilder::TracePropertyAccess(
+    Register object, std::optional<size_t> name_index, Register key,
+    int operation) {
+  if (!v8_flags.trace_property_lookup) return;
+  // Emit once before the access, independently of IC state or execution tier.
+  // The runtime returns the saved accumulator without evaluating getters or
+  // coercing object keys. No probe bytecodes exist when tracing is disabled.
+  RegisterList args = register_allocator()->NewRegisterList(4);
+  StoreAccumulatorInRegister(args[2]);
+  MoveRegister(object, args[0]);
+  if (name_index.has_value()) {
+    OutputLdaConstant(*name_index);
+  } else {
+    LoadAccumulatorWithRegister(key.is_valid() ? key : args[2]);
+  }
+  StoreAccumulatorInRegister(args[1]);
+  LoadLiteral(Smi::FromInt(operation));
+  StoreAccumulatorInRegister(args[3]);
+  CallRuntime(Runtime::kTracePropertyLookup, args);
+  register_allocator()->ReleaseRegisters(args.first_register().index());
+}
