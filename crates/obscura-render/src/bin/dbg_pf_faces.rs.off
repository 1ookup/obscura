fn main() {
    let bytes = std::fs::read("/System/Library/Fonts/PingFang.ttc").expect("PingFang.ttc");
    let mut db = cosmic_text::fontdb::Database::new();
    let source = cosmic_text::fontdb::Source::Binary(std::sync::Arc::new(bytes));
    let ids = db.load_font_source(source);
    eprintln!("faces: {}", ids.len());
    for id in &ids {
        let face = db.face(*id).unwrap();
        let fams: Vec<String> = face.families.iter().map(|(n, _)| n.clone()).collect();
        eprintln!("  id={:?} fam={:?} weight={}", id, fams, face.weight.0);
    }
}
